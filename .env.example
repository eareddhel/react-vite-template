APP_ENV=dev
APP_DEBUG=true
APP_TIMEZONE=America/Santiago
APP_READY_CHECK_DB=false

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=template
DB_CHARSET=utf8mb4
DB_USERNAME=root
DB_PASSWORD=
DB_DUMP_BIN=mysqldump

APP_LOG_MAX_BYTES=5242880
APP_LOG_RETENTION_DAYS=30
APP_BACKUP_RETENTION_DAYS=14
APP_BACKUP_COMPRESS=true

SESSION_DOMAIN=localhost
SESSION_SECURE=false
SESSION_SAMESITE=Lax

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=usuario@example.com
MAIL_PASSWORD=change_me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Template App
